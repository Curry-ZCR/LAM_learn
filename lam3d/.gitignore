# =============================================================================
#  lam3d/.gitignore — 单图生成 3D 数字人前端
#
#  原则：只提交「源码 + 静态前端 + 脚本 + 文档 + README 引用的演示截图」；
#        运行期产物（任务目录、上传原图、日志、截图全集）不入库。
# =============================================================================

# ---------------------------- Python 产物 ------------------------------------
__pycache__/
*.py[cod]
*.so
.venv/
venv/

# ---------------------------- 运行期产物 -------------------------------------
# 每次生成的任务目录（6.9 GB：tracked_flame_params / 权重 / 导出网格）
workspace/jobs/
# 用户上传的原图
workspace/uploads/
# 服务日志与 pid
logs/

# ---------------------------- e2e 截图 --------------------------------------
# 端到端测试会产出 80+ 张截图（约 37 MB）。默认忽略全部，
# 只保留 README「演示截图」一节引用的那几张。
workspace/e2e/*
!workspace/e2e/*.md
!workspace/e2e/*.json
!workspace/e2e/*.log
!workspace/e2e/0_hero.png
!workspace/e2e/0_hero_side.png
!workspace/e2e/demo_*.png
!workspace/e2e/2_result.png
!workspace/e2e/3_interact.png
